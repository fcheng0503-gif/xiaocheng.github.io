    <style>
        :root {
            --bg-color: #f5f7fb;
            --card-bg: #ffffff;
            --text-color: #333333;
            --text-muted: #777777;
            --primary-color: #4f46e5;
            --hover-shadow: rgba(79, 70, 229, 0.15);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
            padding: 40px 20px;
        }

        .container {
            max-width: 1300px;
            margin: 0 auto;
        }

        header {
            margin-bottom: 45px;
            text-align: center;
        }

        header h1 {
            font-size: 2.6rem;
            color: #111827;
            margin-bottom: 10px;
            font-weight: 800;
        }

        header p {
            color: var(--text-muted);
            font-size: 1.1rem;
        }

        /* 分类区块 */
        .category-section {
            margin-bottom: 40px;
        }

        .category-title {
            font-size: 1.35rem;
            color: #1f2937;
            margin-bottom: 18px;
            padding-left: 12px;
            border-left: 5px solid var(--primary-color);
            font-weight: 700;
        }

        /* 网格布局 */
        .links-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 20px;
        }

        /* 卡片样式 */
        .card {
            background-color: var(--card-bg);
            border-radius: 12px;
            padding: 22px;
            text-decoration: none;
            color: var(--text-color);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            border: 1px solid #e5e7eb;
        }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 20px -3px var(--hover-shadow);
            border-color: var(--primary-color);
        }

        .card .title {
            font-size: 1.15rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: #111827;
        }

        .card .desc {
            font-size: 0.85rem;
            color: var(--text-muted);
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        /* 预留/特殊卡片 */
        .card.dashed {
            border-style: dashed;
            background: transparent;
            justify-content: center;
            align-items: center;
            min-height: 106px;
        }
        .card.dashed .title {
            color: var(--text-muted);
            margin-bottom: 0;
        }

        /* 响应式调整 */
        @media (max-width: 600px) {
            body {
                padding: 20px 10px;
            }
            header h1 {
                font-size: 2rem;
            }
        }
    </style>
</head>
